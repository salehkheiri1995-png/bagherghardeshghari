# ===================================
# دیتابیس
# ===================================
DATABASE_URL="file:./dev.db"

# ===================================
# احراز هویت (JWT)
# حداقل ۳۲ کاراکتر تصادفی استفاده کن
# ===================================
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-here"
JWT_EXPIRES_IN="7d"

# ===================================
# پرداخت Stripe
# دریافت از: https://dashboard.stripe.com/apikeys
# ===================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# از Stripe CLI: stripe listen --forward-to localhost:3000/api/payment/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# ===================================
# ایمیل (Nodemailer)
# برای Gmail یک App Password بسازید:
# https://myaccount.google.com/apppasswords
# ===================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your@email.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="VisitIran <no-reply@visitiran.com>"

# ===================================
# آدرس سایت
# ===================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="VisitIran | باقر گردشگری"

# ===================================
# آپشنال: Cloudinary (اگر از Cloudinary برای تصویر استفاده می‌کنید)
# ===================================
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
