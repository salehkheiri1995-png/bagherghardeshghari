# Database
# Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (Turso/LibSQL)
# DATABASE_URL="libsql://your-db-url.turso.io?authToken=your-token"

# Production (PostgreSQL) - requires changing schema.prisma provider to postgresql
# DATABASE_URL="postgresql://user:password@host:5432/visitiran"

# JWT
JWT_SECRET="your-super-secret-jwt-key-that-is-at-least-32-characters-long"
JWT_EXPIRES_IN="7d"

# Stripe (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email SMTP (optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@visitiran.com"

# File Upload
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="VisitIran | باقر گردشگری"

# Upstash Redis (optional, for rate limiting in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Service Prices (USD, per guest)
SERVICE_PRICE_TRANSPORT="50"
SERVICE_PRICE_ACCOMMODATION="100"
SERVICE_PRICE_INSURANCE="30"
SERVICE_PRICE_VISA="80"

# Currency
USD_TO_TOMAN="60000"
